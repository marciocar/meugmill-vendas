{
  "name": "@meugmill/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:perf": "PERF_ASSERT=1 vitest run --no-file-parallelism test/domain/conflicts-volume.test.ts test/domain/eligibility-query.test.ts",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch src/server.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.1",
    "@meugmill/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
